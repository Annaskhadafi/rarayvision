# ==========================================
# Raray Vision - Environment Configuration
# ==========================================

# Environment Mode ("development" or "production")
ENV=development
ALLOWED_ORIGINS=*

# Database Connection (PostgreSQL with pgvector)
DATABASE_URL=postgresql://raray:yourpassword@localhost:5432/rarayvision

# JWT Authentication
SECRET_KEY=af8ab971bf9210d90d5b615f4e5359594707750d582e8d824a973e329726ee42
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ------------------------------------------
# OpenRouter LLM & Embeddings Configuration
# ------------------------------------------
# API Key OpenRouter
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# LLM Chat Model (Default: Google Gemini 3.7 Flash)
OPENROUTER_MODEL=google/gemini-3.7-flash

# Embedding Model for Large Files (Default: Qwen3 Embedding 8B)
OPENROUTER_EMBEDDING_MODEL=qwen/qwen3-embedding-8b

# Embedding Provider: "local" (FastEmbed ONNX) or "openrouter" (forces OpenRouter for all files)
# EMBEDDING_PROVIDER=openrouter

# ------------------------------------------
# Reranker Configuration (Cross-Encoder)
# ------------------------------------------
# Aktifkan (true) atau Nonaktifkan (false) Reranker
ENABLE_RERANK=true

# Provider Reranker: "local" (FastEmbed ONNX) atau "openrouter"
# RERANKER_PROVIDER=openrouter

# Model Reranker:
# - Untuk OpenRouter: "cohere/rerank-v3.5", "nvidia/nv-rerankqa-mistral-4b-v3", atau "qwen/qwen3-rerank"
# - Untuk Local ONNX: "Xenova/ms-marco-MiniLM-L-6-v2"
RERANKER_MODEL=cohere/rerank-v3.5

# ------------------------------------------
# Fallback LLM Providers (Opsional)
# ------------------------------------------
# Groq LPU API
# GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxx
# GROQ_MODEL=llama-3.3-70b-versatile

# Google Gemini Direct API
# GEMINI_API_KEY=AIzaxxxxxxxxxxxxxxxxxxxxx

# Redis Persistent Memory / Semantic Cache (Opsional)
# REDIS_HOST=localhost
# REDIS_PORT=6379
